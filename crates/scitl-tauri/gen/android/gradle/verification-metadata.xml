<?xml version="1.0" encoding="UTF-8"?>
<!-- Mavenの依存のうち、HTTPSの証明書の検証で使うrustls-platform-verifierのKotlinの部品だけを、
     SHA-256で固定する。上流はGitHubのブランチ(書き換えられうる)をMavenのリポジトリにしているため。
     ほかのグループは照らさない。版を上げたら、新しい版の項に置き換える
     (docs/spec/architecture/network-secrets.md「Androidの信頼ルート」)。 -->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!org[.]rustls$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="org.rustls" name="rustls-platform-verifier" version="0.2.0">
         <artifact name="rustls-platform-verifier-0.2.0.aar">
            <sha256 value="aa021794230fbc2f0be355999e2cf67398dd563de066a2e17001ffbd0b69101b" origin="maven-archive 1aa691352a5e"/>
         </artifact>
         <artifact name="rustls-platform-verifier-0.2.0.pom">
            <sha256 value="78dcb69a1a20e91e72017de9a67104bba1874a7ecc8e6dcdfb2fe1a85de6b362" origin="maven-archive 1aa691352a5e"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
